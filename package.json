{
  "name": "family-budget-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @shopping-assistant/web --filter @shopping-assistant/admin dev",
    "dev:web": "pnpm --filter @shopping-assistant/web dev",
    "dev:admin": "pnpm --filter @shopping-assistant/admin dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}
