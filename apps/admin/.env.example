# Admin app (apps/admin) — app-level auth env (2026-06-24 migration off Cloudflare Access).
# Set these in Vercel (Production + Preview). All are SERVER-ONLY unless prefixed NEXT_PUBLIC_.
# NEVER commit real values. NEVER prefix the secrets with NEXT_PUBLIC_ (that ships them to the browser).

# ── NextAuth / Auth.js (Google OAuth) ──────────────────────────────────────────
# Session cookie signing secret:  openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type
# "Web application"). Authorized redirect URI: https://<this-app-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The app's public origin (deterministic OAuth callback construction behind Vercel's proxy).
# Production: https://admin.pingtally.com   Preview: the STABLE preview alias URL.
AUTH_URL=https://admin.pingtally.com

# ── App-level admin authorization ──────────────────────────────────────────────
# Comma-separated admin email allowlist. MUST equal the backend ADMIN_ACCESS_EMAIL_ALLOWLIST
# (same lowercased values). Keep a second break-glass admin so an allowlist typo can't lock you out.
ADMIN_ALLOWED_EMAILS=owner@example.com,break-glass@example.com
# Server-to-server admin service token. MUST equal the backend ADMIN_SERVICE_TOKEN, byte-for-byte.
# Strong random, >= 32 chars:  openssl rand -base64 48 . Server-only; never NEXT_PUBLIC; never logged.
ADMIN_SERVICE_TOKEN=

# ── Backend origin ─────────────────────────────────────────────────────────────
ADMIN_BACKEND_ORIGIN=https://api.pingtally.com
# Public API base for the consumer-shared api-client (already set in production).
NEXT_PUBLIC_API_URL=https://api.pingtally.com
