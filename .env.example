# URL of the deployed backend API. REQUIRED in production — set in Vercel
# (Settings → Environment Variables) for BOTH Production and Preview. The
# frontend bundle throws at build/runtime if this is missing in production;
# there is no silent localhost fallback in production paths.
# Development: leave unset to use the dev fallback http://localhost:3333.
NEXT_PUBLIC_API_URL=https://api.pingtally.com
